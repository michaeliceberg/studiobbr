# Локально: npm run db:local поднимает встроенную базу на этом адресе. На сервере — своя база и роль.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable
SESSION_SECRET=
MASTER_PASSWORD=
UPLOAD_DIR=./uploads
# ИИ-подбор. Без ключа всё остальное работает, подбор пишет «ИИ не подключён».
ANTHROPIC_API_KEY=
# На сервере в России: адрес Cloudflare-прокси и публичный адрес сайта (фото уходит ссылкой, прокси рвёт тела > ~30 КБ)
# ANTHROPIC_BASE_URL=
# PUBLIC_URL=
